@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

@* Disabled until the circuit is interactive, so early clicks are not lost (Playwright waits for enabled) *@
<button class="btn btn-primary" disabled="@(!RendererInfo.IsInteractive)" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
